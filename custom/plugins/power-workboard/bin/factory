#!/usr/bin/env bash
# CUSTOM(factory): validate a Power Workboard factory, or write its JSON Schemas (docs/factory.md).
#
#   factory validate [dir]   print errors (file:line) and warnings; exit 1 on any error
#   factory schema [dir]     write <dir>/.schema/*.json for editor completion
#
# The directory defaults to $PASEO_HOME/factory (~/.paseo/factory). Runs the plugin's TypeScript
# through the Paseo checkout's tsx.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
root="$(cd "$here/../../../.." && pwd)"
FACTORY_CWD="$PWD" exec npx --prefix "$root" tsx "$here/../server/factory/cli.ts" "$@"
